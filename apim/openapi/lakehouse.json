{
  "openapi": "3.0.1",
  "info": {
    "title": "Fabric Lakehouse OAuth API",
    "version": "1.0.0",
    "description": "Runs read-only Lakehouse SQL through the private OBO broker.",
    "contact": {
      "name": "Fabric Parts Shortages Operations"
    }
  },
  "x-security-controls": {
    "rateLimiting": {
      "accountRecoveryThresholds": {
        "maxAttempts": 5,
        "windowSeconds": 900
      },
      "payloadSizeLimitKb": 64,
      "ipBasedThrottling": true,
      "spikeArrest": true,
      "subscriptionOrUserRateLimits": true
    },
    "inputValidation": "APIM validates the delegated JWT and the broker validates the query body.",
    "errorHandling": "APIM and the broker return sanitized errors without token or body logging."
  },
  "paths": {
    "/query": {
      "post": {
        "operationId": "query",
        "summary": "Run a read-only Lakehouse query",
        "description": "Runs one read-only SQL statement as the delegated Fabric user.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "statement"
                ],
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A read-only SQL statement."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lakehouse query result."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/tables": {
      "get": {
        "operationId": "tables",
        "summary": "List Lakehouse tables",
        "description": "Lists tables visible to the delegated Fabric user.",
        "responses": {
          "200": {
            "description": "Lakehouse table list."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/knowledge": {
      "post": {
        "operationId": "knowledge",
        "summary": "Search open Lakehouse shortages",
        "description": "Returns at most 15 citation-ready snippets from the governed open-shortage view under the delegated user's permissions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "description": "Context-aware knowledge search query."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Citation-ready Lakehouse knowledge results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "query",
                    "results"
                  ],
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "results": {
                      "type": "array",
                      "maxItems": 15,
                      "items": {
                        "type": "object",
                        "required": [
                          "snippet",
                          "title",
                          "url"
                        ],
                        "properties": {
                          "snippet": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}